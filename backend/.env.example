# AI 판단 엔진: claude_code | rule
#   claude_code = 이 PC에 설치·로그인된 Claude Code(claude -p)로 판단 (API 키 불필요)
#   rule        = 규칙 기반으로 동작 (개발·테스트·시연 장애 대비용)
LLM_PROVIDER=rule

# claude 실행 파일 경로. 비우면 PATH에서 찾음 (예: C:\Users\이름\.local\bin\claude.exe)
CLAUDE_CLI=
# 모델 전체 이름 (기본 Claude Opus 5.5). 별칭 sonnet | opus | haiku 도 가능
CLAUDE_MODEL=claude-opus-5-5
# 추론 깊이 (low | medium | high): 계획·판단·작성 단계 / 분류·정보확인·검토 단계
CLAUDE_EFFORT=medium
CLAUDE_EFFORT_FAST=low
# 사진 분석(현장 사진을 보고 불편 짐작). 모델을 비우면 CLAUDE_MODEL과 같은 모델, 추론 깊이 기본 high
CLAUDE_VISION_MODEL=
CLAUDE_EFFORT_VISION=high
# 단계 하나를 기다리는 최대 시간(초). 넘으면 규칙 엔진으로 대체
CLAUDE_TIMEOUT=120

# 카카오 로컬 API REST 키 (위치 확인·주변 기관 검색)
KAKAO_REST_API_KEY=

# 공공데이터포털 서비스키 (비슷한 민원 사례 조회: 국민권익위원회_민원정책 질의응답조회서비스 활용신청 필요)
#   무인민원발급기 운영시간: 같은 키로 「행정안전부_무인민원발급기정보 조회서비스」도 활용신청 (자동승인)
#   포털 마이페이지의 '일반 인증키(Decoding)'를 넣는다. Encoding 키를 넣어도 자동으로 풀어서 씀
DATA_GO_KR_SERVICE_KEY=

# 민원 패키지 PDF용 한글 글꼴(TTF). 비우면 맑은 고딕(Windows)·애플고딕(Mac)·나눔고딕(Linux)을 찾음
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# 추가 질문 최대 횟수
MAX_QUESTION_ROUNDS=2

CORS_ORIGINS=http://localhost:5173
