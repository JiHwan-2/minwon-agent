# AI 판단 엔진: claude_code | rule
#   claude_code = 이 PC에 설치·로그인된 Claude Code(claude -p)로 판단 (API 키 불필요)
#   rule        = 규칙 기반으로 동작 (개발·테스트·시연 장애 대비용)
LLM_PROVIDER=rule

# claude 실행 파일 경로. 비우면 PATH에서 찾음 (예: C:\Users\이름\.local\bin\claude.exe)
CLAUDE_CLI=
# 모델: sonnet | opus | haiku 등 별칭 또는 전체 이름
CLAUDE_MODEL=sonnet
# 추론 깊이 (low | medium | high): 계획·판단·작성 단계 / 분류·정보확인·검토 단계
CLAUDE_EFFORT=medium
CLAUDE_EFFORT_FAST=low
# 단계 하나를 기다리는 최대 시간(초). 넘으면 규칙 엔진으로 대체
CLAUDE_TIMEOUT=120

# 카카오 로컬 API REST 키 (위치 확인·주변 기관 검색)
KAKAO_REST_API_KEY=

# 추가 질문 최대 횟수
MAX_QUESTION_ROUNDS=2

CORS_ORIGINS=http://localhost:5173
