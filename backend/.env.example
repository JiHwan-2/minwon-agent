# AI 판단 엔진: anthropic | openai | rule
#   rule = API 키 없이 규칙 기반으로 동작 (개발·테스트·시연 장애 대비용)
LLM_PROVIDER=rule

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 추론 깊이 (low | medium | high): 계획·작성 단계 / 분류·정보확인 단계
ANTHROPIC_EFFORT=medium
ANTHROPIC_EFFORT_FAST=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# 카카오 로컬 API REST 키 (3일차 Tool 연결에서 사용)
KAKAO_REST_API_KEY=

# 추가 질문 최대 횟수
MAX_QUESTION_ROUNDS=2

CORS_ORIGINS=http://localhost:5173
